# Sanity: sin estas variables el sitio usa el contenido local (app/lib/posts.ts y app/lib/settings.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Webhook de Sanity -> /api/revalidate?secret=<este valor>
SANITY_REVALIDATE_SECRET=

# Vista previa de borradores (opcional)
# Token con permiso "Viewer": sanity.io/manage > API > Tokens. Solo lo usa el servidor
SANITY_API_READ_TOKEN=
# Cualquier texto largo; el estudio y el sitio deben usar el mismo valor
SANITY_PREVIEW_SECRET=
SANITY_STUDIO_PREVIEW_SECRET=
# URL del sitio que abre el botón "Open preview" del estudio (por defecto http://localhost:3000)
SANITY_STUDIO_SITE_URL=

# URL pública del sitio (metadata, sitemap, robots). Opcional: en Vercel se toma sola del dominio de producción
NEXT_PUBLIC_SITE_URL=
