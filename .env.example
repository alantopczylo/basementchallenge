# Copiá este archivo a .env.local y completá el id del proyecto (sanity.io/manage).
# Sin estas variables el sitio usa el contenido local (app/lib/posts.ts y app/lib/settings.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Opcional: secreto del webhook de Sanity -> /api/revalidate?secret=<este valor> (publicar se ve al instante)
# SANITY_REVALIDATE_SECRET=
